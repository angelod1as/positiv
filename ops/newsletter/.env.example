# Listmonk newsletter stack — copy to .env and fill in.
# The real .env is gitignored and lives only on the host running the stack.

# Postgres backing the Listmonk instance
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Optional: creates the Listmonk super admin on the first `docker compose up`.
# Leave empty to set the admin up through the web UI on first visit.
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
