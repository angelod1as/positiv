{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy --yes --schema-required",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest --run",
    "seed": "sanity exec seed/cli.ts --with-user-token",
    "fixtures": "tsx fixtures/cli.ts",
    "refresh-dev": "sanity exec refresh-dev/cli.ts --with-user-token --",
