  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "6.19.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/eslint-config-studio": "^7",
    "@sanity/export": "^7.0.3",
    "@sanity/import": "^7.0.4",
    "@sanity/schema": "6.19.0",
    "@sanity/validation": "6.19.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "groq-js": "^2.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8",
    "vitest": "^3.2.4"
  }
