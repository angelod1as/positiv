{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy --yes --schema-required",
    "dev": "sanity dev",
    "start": "sanity start",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest --run",
    "seed": "sanity exec seed/cli.ts --with-user-token",
    "migrate:homepage-to-page": "sanity exec migrations/homepage-to-page/cli.ts --with-user-token --",
    "migrate:code-of-conduct-to-page": "sanity exec migrations/code-of-conduct-to-page/cli.ts --with-user-token --",
    "migrate:remove-footer-development": "sanity exec migrations/remove-footer-development/cli.ts --with-user-token --"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.2",
    "@sanity/vision": "^6.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "6.17.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/eslint-config-studio": "^7",
    "@sanity/schema": "6.17.0",
    "@sanity/validation": "6.17.0",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.1",
    "typescript": "^5.8",
    "vitest": "^3.2.4"
  }
}
