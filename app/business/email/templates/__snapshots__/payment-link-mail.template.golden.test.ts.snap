// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`paymentLinkMailTemplate byte-for-byte > renders the frozen HTML with the default copy 1`] = `
"<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Pagamento - Positiv</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Nunito', 'Helvetica Neue', Arial, sans-serif;">

  <!-- Outer Wrapper: Brand Purple Gradient -->
  <div style="background-color: #853cca; background-image: linear-gradient(135deg, #4a75d2 0%, #bf03c3 100%); padding: 40px 20px;">

    <!-- Email Container -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" style="max-width: 600px; margin: 0 auto;">
      <tr>
        <td>
          <div style="background-color: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">

            <!-- Header with Logo -->
            <div style="text-align: center; padding: 30px 24px 20px 24px; background-color: #ffffff;">
              <img src="https://www.positivparty.com/positiv-logo-colors.png" alt="Positiv" width="250" style="max-width: 250px; height: auto; margin: 0 auto; display: block;">
            </div>

            <!-- Main Content Area -->
            <div style="padding: 0 24px 30px 24px; color: #333333;">

              <!-- H1 -->
              <h1 style="font-family: 'DM Sans', Arial, sans-serif; font-size: 32px; font-weight: 800; color: #bf03c3; margin: 0 0 16px 0; line-height: 1.2; text-align: center;">
                Hora de garantir sua vaga
              </h1>

              <!-- Intro Paragraph -->
              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0; color: #333;">
                Ana Souza, sua vaga na <strong>🌸&nbsp;Festa de Primavera</strong> está reservada!
              </p>

              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0; color: #333;">
                Para garanti-la, só falta um passo: o pagamento.
              </p>

              <!-- Prices -->
              <div style="background-color: #f9f9f9; border-radius: 8px; padding: 16px; margin: 0 0 20px 0;">
                
                <div style="margin-bottom: 8px; font-size: 16px; color: #333;">
                  No Pix (10% de desconto): <strong>R$ 225,00</strong>
                </div>
                
                <div style="margin-bottom: 8px; font-size: 16px; color: #333;">
                  No cartão de crédito (1x a 6x sem juros): R$ 250,00
                </div>
                
              </div>

              <!-- CTA -->
              <div style="text-align: center; margin: 0 0 20px 0;">
                <a href="https://www.positivparty.com/pagamento/abc-123" style="display: inline-block; background-color: #bf03c3; color: #ffffff; font-family: 'DM Sans', Arial, sans-serif; font-size: 16px; font-weight: 700; text-decoration: none; padding: 14px 32px; border-radius: 8px;">
                  Pagar agora
                </a>
              </div>

              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 14px; line-height: 1.6; margin: 0 0 8px 0; color: #333;">
                <strong>O link vale até 31/12/2026.</strong>
              </p>

              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 14px; line-height: 1.6; margin: 0; color: #666;">
                Depois dessa data o link expira e você precisa pedir um novo para a organização.
              </p>

            </div>

            <!-- Footer -->
            <div style="background-color: #f9f9f9; padding: 24px; text-align: center; border-top: 1px solid #e0e0e0;">
              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 14px; color: #666666; margin: 0 0 8px 0;">
                Você recebeu este e-mail pois se candidatou a um evento da
                <a href="https://www.positivparty.com/?utm_source=email&amp;utm_medium=transactional&amp;utm_campaign=payment-link" style="color: #bf03c3; text-decoration: none; font-weight: 700;">Positiv</a>
              </p>
              <p style="font-family: 'Nunito', Arial, sans-serif; font-size: 14px; color: #666666; margin: 0;">
                <a href="https://www.positivparty.com/conta?utm_source=email&amp;utm_medium=transactional&amp;utm_campaign=payment-link" style="color: #666; text-decoration: underline;">Configurações</a>
              </p>
            </div>

          </div>
        </td>
      </tr>
    </table>

  </div>

</body>
</html>"
`;
