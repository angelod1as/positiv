AWS_SECRET_ACCESS_KEY=

# Email Marketing
UNSUBSCRIBE_SECRET=  # Secret key for unsubscribe link validation
INTERNAL_JOB_SECRET= # Bearer token for internal cron job authentication (e.g., newsletter campaign processing)

# Listmonk Newsletter
LISTMONK_API_URL=
LISTMONK_API_USERNAME=
LISTMONK_API_PASSWORD=

# Google Tag Manager
VITE_GTM_ID=

# Analytics - Umami (get from your Umami dashboard)
VITE_UMAMI_WEBSITE_ID=  # Website ID from Umami settings
VITE_UMAMI_URL=         # Your Umami instance URL (e.g., https://umami.example.com)

# Supabase
