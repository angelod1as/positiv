APP_URL=

# Telegram Alerts (Winston Logger)
# 1. Message @BotFather on Telegram -> /newbot -> name "Positiv Alerts"
# 2. Copy bot token -> TELEGRAM_BOT_TOKEN
# 3. Create Telegram group, add bot, send a message
# 4. GET https://api.telegram.org/bot<TOKEN>/getUpdates -> extract chat.id (negative for groups)
# 5. Set TELEGRAM_CHAT_ID and TELEGRAM_ALERTS_ENABLED=true in Coolify
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# Cloudflare Turnstile (Bot Protection)
# Get your keys from: https://dash.cloudflare.com/
# For local development, use test keys to always see the widget:
# Site Key: 1x00000000000000000000AA
# Secret Key: 1x0000000000000000000000000000000AA
# Production keys - NEVER use test keys in production
VITE_TURNSTILE_SITE_KEY=
SUPABASE_TURNSTILE_SECRET=

# LISTMONK
LISTMONK_API_USER=
LISTMONK_API_KEY=

# ASAAS
# Sandbox URL: https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_API_URL=