# Environment schema for positiv.
#
# This file is the single source of truth for configuration: it declares every
# variable the project reads, its type, and whether it is required. It contains
# no secret values, so it is committed to git and safe for tools and coding
# agents to read.
#
# Real values live in `.env` / `.env.local`, which are gitignored and which
# coding agents are denied read access to in .claude/settings.json. Run
# `varlock load` to check the resolved config; it redacts anything marked
# `@sensitive`, so its output is safe to paste into a log or a transcript.
#
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(VITE_)
# @currentEnv=$APP_ENV
# importMetaEnv=none keeps server-only secrets out of the `import.meta.env`
# type, so referencing one from client code does not typecheck. The app reads
# config through ENV; the only `import.meta.env` left is Vite's own DEV flag,
# typed by vite/client.
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# ---

# Which environment the app is running in. This is deliberately separate from
# NODE_ENV: bundlers force NODE_ENV=production while building, so it cannot
# tell "being built" apart from "serving production traffic". Coolify sets
# APP_ENV=production on the running container; the build leaves it unset.
# @public @type=enum(development, production, test)
APP_ENV=development

# Drives bundler and library behaviour. varlock injects this into any process
# it launches, so anything that needs a different value has to set it in the
# environment, which takes precedence — `pnpm test:integration` does exactly
# that. Use APP_ENV, not this, to reason about the deployment environment.
# @public @type=enum(development, production, test)
NODE_ENV=development

# Set to true by CI providers. Used to disable production-only behaviour.
# @public @type=boolean
CI=false

# Treats a local dev server as production, for debugging against production data.
# @public @type=boolean
IS_PROD_IN_DEV=false

# Legacy flag kept for parity with local .env files. Nothing in the app reads
# it today; IS_PROD_IN_DEV and APP_ENV cover the cases it used to.
# @public @type=boolean @deprecated="Use APP_ENV or IS_PROD_IN_DEV"
IS_PROD=false

# Public URL the app is served from, used to build absolute links in emails.
# @public @type=url @example="https://positiv.com.br"
APP_URL=

# Domain used by the client, without protocol.
# @example="positiv.com.br"
VITE_APP_DOMAIN=

# ---
# Supabase
# ---
# CI/CD uses local Supabase instances for PRs, so there is no staging project.

# @docs("Supabase API settings", https://supabase.com/dashboard/project/_/settings/api)
# @required @type=url
VITE_SUPABASE_URL=
# @required
VITE_SUPABASE_ANON_KEY=
# Server-only secrets. They are required when the app actually runs in
# production, but not while building the image: the build has no business
# holding them, and the platform injects them into the running container.
# @required=forEnv(production) @sensitive
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by kysely.
# @required=forEnv(production) @sensitive @type=url
SUPABASE_CONNECT_URL=

# Used by the Supabase CLI (`pnpm db:types`, migrations), not by the app.
# @sensitive
SUPABASE_ACCESS_TOKEN=
# Project ref, visible in every Supabase dashboard URL.
# @public
SUPABASE_PROJECT_ID=
# @sensitive
SUPABASE_DB_PASSWORD=

# Fallback read by the integration test helpers when VITE_SUPABASE_URL is unset.
# Same public API URL, so it carries the same classification.
# @public @type=url
SUPABASE_URL=

# ---
# Sessions and signed links
# ---

# @required=forEnv(production) @sensitive
COOKIE_SECRET=
# Signs unsubscribe links in newsletter emails.
# @sensitive
UNSUBSCRIBE_SECRET=
# Bearer token authenticating internal cron jobs (campaign processing).
# @sensitive
INTERNAL_JOB_SECRET=

# ---
# Cloudflare Turnstile (bot protection)
# ---
# Local development can use Cloudflare's "always passes" test keys, listed in
# their testing docs. Never use test keys in production.

# @docs("Turnstile dashboard", https://dash.cloudflare.com/)
# @docs("Test keys", https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
VITE_TURNSTILE_SITE_KEY=
# @sensitive
SUPABASE_TURNSTILE_SECRET=

# ---
# Amazon SES (transactional email)
# ---

AWS_ACCESS_KEY_ID=
# @sensitive
AWS_SECRET_ACCESS_KEY=
# @public
IAM_USER_NAME=
SMTP_USER_NAME=
# @sensitive
SMTP_PASSWORD=

# ---
# Listmonk (newsletter)
# ---

# @public @type=url @example="http://localhost:9000"
LISTMONK_API_URL=
LISTMONK_API_USERNAME=
# @sensitive
LISTMONK_API_PASSWORD=

# ---
# Analytics
# ---

VITE_GTM_ID=
# Website ID from Umami settings.
VITE_UMAMI_WEBSITE_ID=
# Umami instance URL.
# @type=url @example="https://umami.example.com"
VITE_UMAMI_URL=

# Shows a warning banner site-wide while set.
VITE_BANNER_MESSAGE=

# ---
# Telegram alerts (winston logger)
# ---
# 1. Message @BotFather -> /newbot -> name "Positiv Alerts"
# 2. Copy the bot token into TELEGRAM_BOT_TOKEN
# 3. Create a Telegram group, add the bot, send a message
# 4. GET https://api.telegram.org/bot<TOKEN>/getUpdates -> read chat.id
#    (negative for groups) into TELEGRAM_CHAT_ID
# 5. Set TELEGRAM_ALERTS_ENABLED=true in Coolify

# @public @type=boolean
TELEGRAM_ALERTS_ENABLED=false
# @sensitive
TELEGRAM_BOT_TOKEN=
# @public
TELEGRAM_CHAT_ID=

# ---
# Test and tooling knobs
# ---

# Identity of the e2e admin account. The password beside it is the secret.
# @public @type=email
TEST_USER_ADMIN_EMAIL=
# @sensitive
TEST_USER_PASSWORD=
# Set by the e2e harness to put the app in end-to-end test mode.
# @public @type=boolean
E2E_MODE=false
# Makes e2e database cleanup fail loudly instead of warning.
# @public @type=boolean
STRICT_CLEANUP=false

# Linear MCP server, used by local tooling only.
# @docs("Linear API keys", https://linear.app/settings/api)
# @sensitive
LINEAR_API_KEY=
# @public
LINEAR_TEAM_ID=
# Vitest worker limits. Unset means "let vitest decide".
# @public @type=number
VITEST_MIN_FORKS=
# @public @type=number
VITEST_MAX_FORKS=

# ---
# CI and ops only
# ---
# The app never reads these. They are declared here so this file stays the
# complete inventory of the project's configuration: GitHub Actions injects
# them from repository secrets, and the deploy and backup workflows consume
# them. Keep them unset locally.

PRODUCTION_PROJECT_ID=
# @sensitive
PRODUCTION_DB_PASSWORD=
# @type=url
PRODUCTION_SUPABASE_URL=
PRODUCTION_SUPABASE_ANON_KEY=
# @sensitive
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
# @sensitive @type=url
PRODUCTION_SUPABASE_CONNECT_URL=

# @type=url
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
# @sensitive @type=url
STAGING_SUPABASE_CONNECT_URL=
STAGING_TURNSTILE_SITE_KEY=
# @sensitive
STAGING_TURNSTILE_SECRET=

# Database backup workflow: rsync target and Telegram notifications.
# @sensitive
VPS_SSH_PRIVATE_KEY=
VPS_HOST=
# @public
VPS_USER=
# @public
VPS_BACKUP_PATH=
# @sensitive
TELEGRAM_TOKEN=
# @public
TELEGRAM_TO=
